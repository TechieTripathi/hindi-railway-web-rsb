# Research-local secrets. Copy to `.env` and fill in only if a research run should use a
# DIFFERENT key from the webapp's. `.env` is gitignored here (see .gitignore); this
# template is not.
#
#     cp .env.example .env
#
# Loaded by shared/config_env.py, which is dependency-free — it does not need
# python-dotenv. Precedence, highest first:
#
#   1. an already-exported process environment variable
#   2. this file's sibling `.env`
#   3. the webapp's .env one directory up, loaded by its config.py at import time
#
# Leaving a value EMPTY is safe and is the default: config_env skips empty values, so
# the webapp's key is used. Check what is actually in play with:
#
#     .venv/bin/python3 research/shared/config_env.py

ANTHROPIC_API_KEY=
BRAVE_API_KEY=
