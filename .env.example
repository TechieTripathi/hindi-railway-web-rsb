# Research secrets. Copy to `.env` and fill in. `.env` is gitignored here (see
# .gitignore); this template is not.
#
#     cp .env.example .env
#
# Loaded by shared/config_env.py, which is dependency-free — it does not need
# python-dotenv. Precedence, highest first:
#
#   1. an already-exported process environment variable
#   2. this file's sibling `.env`
#
# An EMPTY value is skipped, so it never blanks out an exported key. Check what is
# actually in play with:
#
#     .venv/bin/python3 shared/config_env.py

# Required for "Write stories with AI".
ANTHROPIC_API_KEY=
# Optional. Keyword search uses Brave News when this is set (billed per search) and
# falls back to free Bing News RSS when it is not.
BRAVE_API_KEY=
