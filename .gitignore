# research/ is its own git repository, so it does NOT inherit the parent repo's
# .gitignore. Everything that must never be committed has to be listed HERE.
# (An .env with live API keys reached a local commit once because it was not.)

# ── Secrets ──────────────────────────────────────────────────────────────────
.env
# Holds TESTSPRITE_API_KEY; Claude Code injects it into tool shells, so the
# `testsprite` CLI picks it up. The TestSprite MCP server does NOT read it --
# its key lives in local-scope config in ~/.claude.json, outside this repo.
.claude/settings.local.json

# ── Virtual environment ──────────────────────────────────────────────────────
.venv/
venv/

# ── Scraped corpora and generated scores — reproducible, and large ────────────
output/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── Notebooks ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Logs and stray shell output ──────────────────────────────────────────────
*.log
nohup.out
.env
.env
.env
